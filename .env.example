# Скопировать в .env.local для разработки.
# На продакшене значения задаются в Coolify → Environment Variables.
# Файл .env.local в гит не попадает, .env.example — попадает (без значений).

# ─────────────────────────────────────────────
# Заявки с сайта — Telegram
# ─────────────────────────────────────────────
# ВНИМАНИЕ: api.telegram.org недоступен с российских VPS (Timeweb).
# Сейчас заявки доходят только на email. См. docs/ROADMAP.md, Этап 1.
# Токен бота: создать бота у @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата: добавить бота в группу, написать туда сообщение и открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — взять result[].message.chat.id
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# Заявки с сайта — Email (рабочий канал)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# Почтовый ящик, с которого уходят письма
SMTP_USER=
# Пароль приложения из Яндекс ID, НЕ основной пароль от почты
SMTP_PASS=
# Куда доставлять заявки
LEAD_EMAIL_TO=

# ─────────────────────────────────────────────
# Яндекс: Метрика и Вебмастер — для скриптов отчётов
# ─────────────────────────────────────────────
# npm run metrika  ·  npm run webmaster
#
# Один токен на оба сервиса. Создать приложение на https://oauth.yandex.ru/
# (тип «Для доступа к API или отладки») со следующими правами:
#   metrika:read        чтение статистики и целей          — обязательно
#   webmaster:hostinfo  информация о сайтах в Вебмастере    — обязательно
#   metrika:write       создание целей скриптом             — на будущее
#
# После изменения прав уже выданный токен их не подхватывает —
# нужно перевыпустить его заново по ссылке авторизации.
#
# API Вебмастера (api.webmaster.yandex.net) нестабильно отвечает через VPN —
# для npm run webmaster VPN лучше выключать (Метрика работает и с ним).
METRIKA_OAUTH_TOKEN=

# ─────────────────────────────────────────────
# Coolify — только для скрипта управления деплоем
# ─────────────────────────────────────────────
# npm run coolify -- apps
# Адрес панели, например https://coolify.example.com (без слэша в конце)
COOLIFY_URL=
# Токен: Coolify → Keys & Tokens → API tokens
COOLIFY_TOKEN=
# UUID приложения, узнать через: npm run coolify -- apps
COOLIFY_APP_UUID=
